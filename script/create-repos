#!/usr/bin/env bash
# Creates the public GitHub repositories: gemstack-rb/gemstack (the monorepo,
# where development happens) and one read-only mirror per gem.
#
#   unset GITHUB_TOKEN && gh auth login     # as the account that owns gemstack-rb
#   script/create-repos                     # DRY_RUN=1 to only print the commands
#
# ⚠️  These repositories are PUBLIC. See RELEASING.md before running.
set -euo pipefail
cd "$(dirname "$0")/.."
OWNER="${GEMSTACK_OWNER:-gemstack-rb}"
run() { if [ -n "${DRY_RUN:-}" ]; then echo "+ $*"; else "$@"; fi; }

run gh repo create "$OWNER/gemstack" --public \
  --description "GemStack: a fast, modular Ruby API framework for Next.js" --homepage "https://rubygems.org/gems/gemstack"
for gem in $(script/gems); do
  [ "$gem" = "gemstack" ] && continue
  run gh repo create "$OWNER/$gem" --public --disable-issues --disable-wiki \
    --description "Read-only mirror of gems/$gem in $OWNER/gemstack — open issues and pull requests there" \
    --homepage "https://rubygems.org/gems/$gem"
done
