#!/usr/bin/env ruby
# frozen_string_literal: true

# Builds the transition shims for the gem names merged into gemstack in 0.3.0
# (gemstack-core, gemstack-db, …) into pkg/. Each shim depends on
# gemstack >= 0.3.0 and loads its module, so Gemfiles that still list the old
# name keep working. They are released once, with 0.3.0; later releases skip
# them because they are already on rubygems.org.
#
#   script/shims            # build pkg/gemstack-*-0.3.0.gem
#   script/shims list       # print "name version" for each shim
require "fileutils"
require "rubygems/package"
require "tmpdir"

module GemStackShims
  VERSION = "0.3.0"
  ROOT = File.expand_path("..", __dir__)
  # Modules loaded by `require "gemstack"`; the others are switched on in config/app.rb.
  BUILT_IN = %w[core cache schema http contract dev].freeze
  NAMES = %w[core cache schema http db jobs mail storage contract dev].freeze

  module_function

  def gem_name(mod) = "gemstack-#{mod}"

  def finish_step(mod)
    return "(it's loaded by `require \"gemstack\"`)" if BUILT_IN.include?(mod)

    "and make sure `config/app.rb` has `require \"gemstack/#{mod}\"` (apps created with 0.3.0 do)"
  end

  def spec(mod)
    name = gem_name(mod)
    Gem::Specification.new do |s|
      s.name = name
      s.version = VERSION
      s.summary = "Merged into the gemstack gem — remove #{name} from your Gemfile"
      s.description = "Since GemStack 0.3.0, #{name} is part of the gemstack gem. This version only depends " \
                      "on gemstack and loads gemstack/#{mod}, so Gemfiles that still list it keep working."
      s.authors = ["Adware Technologies", "Shoaib Malik"]
      s.email = ["gemstack26@gmail.com"]
      s.license = "MIT"
      s.homepage = "https://github.com/gemstack-rb/gemstack"
      s.required_ruby_version = ">= 3.3"
      s.files = ["README.md", "LICENSE.txt", "CHANGELOG.md", "lib/#{name}.rb"]
      s.require_paths = ["lib"]
      s.metadata = {
        "rubygems_mfa_required" => "true",
        "source_code_uri" => "https://github.com/gemstack-rb/gemstack",
        "changelog_uri" => "https://github.com/gemstack-rb/gemstack/blob/main/CHANGELOG.md",
        "bug_tracker_uri" => "https://github.com/gemstack-rb/gemstack/issues",
        "documentation_uri" => "https://github.com/gemstack-rb/gemstack/tree/main/docs"
      }
      s.post_install_message = "#{name} is now part of the gemstack gem. Remove `gem \"#{name}\"` from your " \
                               "Gemfile #{finish_step(mod)}."
      s.add_dependency "gemstack", ">= #{VERSION}", "< 1.0"
    end
  end

  # The shim's files, relative to its directory.
  def files(mod)
    name = gem_name(mod)
    {
      "lib/#{name}.rb" => <<~RUBY,
        # frozen_string_literal: true

        # #{name} is part of the gemstack gem since 0.3.0. This shim keeps Gemfiles
        # that still list #{name} working; remove the line from your Gemfile.
        require "gemstack/#{mod}"
      RUBY
      "README.md" => <<~MD,
        # #{name}

        **Merged into [`gemstack`](https://rubygems.org/gems/gemstack) in GemStack 0.3.0.**

        This version is a transition shim: it depends on `gemstack` and loads `gemstack/#{mod}`, so
        Gemfiles that still list `#{name}` keep working. To finish upgrading, remove `gem "#{name}"`
        from your Gemfile #{finish_step(mod)}.

        GemStack is a modular Ruby API framework for Next.js applications by
        [Adware Technologies](https://www.adwaretech.com) — [gemstack-rb/gemstack](https://github.com/gemstack-rb/gemstack).

        ## License

        Open source under the MIT License — © [Adware Technologies](https://www.adwaretech.com). See [LICENSE.txt](LICENSE.txt).
      MD
      "CHANGELOG.md" => "# Changelog\n\n## #{VERSION}\n\nMerged into the gemstack gem; this version is a " \
                        "transition shim. See the [GemStack changelog](https://github.com/gemstack-rb/gemstack/blob/main/CHANGELOG.md).\n",
      "LICENSE.txt" => File.read(File.join(ROOT, "LICENSE.txt"))
    }
  end

  # Writes each shim to a scratch directory and builds pkg/<name>-0.3.0.gem.
  def build(out_dir = File.join(ROOT, "pkg"))
    FileUtils.mkdir_p(out_dir)
    NAMES.map do |mod|
      Dir.mktmpdir("gemstack-shim") do |dir|
        files(mod).each do |rel, content|
          FileUtils.mkdir_p(File.dirname(File.join(dir, rel)))
          File.write(File.join(dir, rel), content)
        end
        file = Dir.chdir(dir) do
          Gem::DefaultUserInteraction.use_ui(Gem::SilentUI.new) { Gem::Package.build(spec(mod)) }
        end
        target = File.join(out_dir, File.basename(file))
        FileUtils.mv(File.join(dir, file), target)
        target
      end
    end
  end
end

if $PROGRAM_NAME == __FILE__
  if ARGV.first == "list"
    GemStackShims::NAMES.each { |mod| puts "#{GemStackShims.gem_name(mod)} #{GemStackShims::VERSION}" }
  else
    GemStackShims.build.each { |file| puts "built #{file.delete_prefix("#{GemStackShims::ROOT}/")}" }
  end
end
